# From https://www.terminal3.io/claim-page (or the campaign link).
# Shown once. Never commit the real value.
# This is an Ethereum-style secp256k1 private key (0x-prefixed hex),
# NOT a typical SaaS token.
T3N_API_KEY=

# Optional. Separate agent key if you mint an org-owned agent.
# Never reuse T3N_API_KEY as AGENT_KEY.
AGENT_KEY=

# testnet is the public SDK default. sandbox and testnet are the same cluster.
T3N_ENV=testnet

# Optional. Used only by the local Node demo if you later add an LLM.
# The v1 brief is extractive and does not need this.
OPENAI_API_KEY=
